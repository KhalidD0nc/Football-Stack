# Copy to .env. Local lake mode is enabled by default; fill only the services you use.
# Storage
STORAGE_BACKEND=local
LOCAL_ROOT=data_lake

# AWS 
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-north-1
S3_BUCKET=your_s3_bucket_name
S3_BUCKET_TEST=your_s3_test_bucket_name

# GCP 
GCS_BUCKET=your_gcs_bucket_name
GCS_PROJECT=your_gcs_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-credentials.json
GCP_BUCKET_TEST=your_gcs_test_bucket_name

# API-Football
API_FOOTBALL_KEY=your_api_football_key_here
API_BASE_URL=https://v3.football.api-sports.io

LEAGUE_ID=307
SEASON=2025

# Snowflake (used by dbt profiles.yml)
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_ROLE=your_pipeline_role
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=LEAGUES_DATA
SNOWFLAKE_DATABASE_TEST=LEAGUES_DATA_TEST
SNOWFLAKE_SCHEMA=STAGING
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/your/rsa_key.pem
WAREHOUSE_URI=snowflake://USER:PASSWORD@ACCOUNT_IDENTIFIER/DATABASE/SCHEMA?warehouse=WH&role=ROLE&private_key_file=/path/to/key.pem
WAREHOUSE_URI_TEST=snowflake://USER:PASSWORD@ACCOUNT_IDENTIFIER/DATABASE_TEST/SCHEMA?warehouse=WH&role=ROLE&private_key_file=/path/to/key.pem

DATA_WAREHOUSE=none

# Airflow (only needed when running with the airflow docker-compose profile)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_PASSWORD=admin
