# API-Football
API_FOOTBALL_KEY=replace_me
API_BASE_URL=https://v3.football.api-sports.io
LEAGUE_ID=replace_me
TEAM_ID=0
SEASON=replace_me
TIMEZONE=Asia/Riyadh
PLAYERS_MAX_PAGES=200

# Storage — defaults to local filesystem (no cloud deps needed)
STORAGE_BACKEND=local
LOCAL_ROOT=data_lake

# AWS (required only when STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=replace_me
# AWS_SECRET_ACCESS_KEY=replace_me
# AWS_REGION=us-east-1
# S3_BUCKET=replace_me

# GCS (required only when STORAGE_BACKEND=gcs)
# GCS_BUCKET=replace_me
# GCS_PROJECT=replace_me

# Snowflake (used by dbt profiles.yml)
SNOWFLAKE_ACCOUNT=replace_me
SNOWFLAKE_USER=replace_me
SNOWFLAKE_ROLE=replace_me
SNOWFLAKE_WAREHOUSE=replace_me
SNOWFLAKE_DATABASE=replace_me
SNOWFLAKE_SCHEMA=replace_me
SNOWFLAKE_PRIVATE_KEY_PATH=replace_me
